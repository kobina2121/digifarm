# Copy to .env and fill in. Never commit real secrets.

APP_URL=http://localhost:3000
# development | staging | production — staging/production refuse dev-only email and storage.
APP_ENV=development
LOG_LEVEL=debug

# --- Database: Neon (ROADMAP D13) ---
# Use a Neon *branch* for development (e.g. "dev"), never the production branch.
# Pooled connection (host contains "-pooler") for the app:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/digifarm?sslmode=require
# Direct connection (same host without "-pooler") for migrations:
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/digifarm?sslmode=require

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000

# --- Google sign-in (optional) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application). Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
# plus your staging/production domains. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# "console" prints emails (with verification links) to the dev server log.
# A real provider adapter is added before staging (ROADMAP §6).
EMAIL_TRANSPORT=console
EMAIL_FROM="DigiFarm <no-reply@digifarm.local>"

# --- File storage ---
# "local" stores private files in STORAGE_LOCAL_DIR (gitignored) for development.
# An S3-compatible driver (R2/S3) is added before staging (ROADMAP §6).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage

# Integration tests use a separate database (e.g. a Neon "test" branch).
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=
