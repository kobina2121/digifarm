# Copy to .env and fill in. Never commit real secrets.

APP_URL=http://localhost:3000
# development | staging | production — staging/production refuse dev-only email and storage.
APP_ENV=development
LOG_LEVEL=debug

# --- Database: Neon (ROADMAP D13) ---
# Use a Neon *branch* for development (e.g. "dev"), never the production branch.
# Pooled connection (host contains "-pooler") for the app:
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/digifarm?sslmode=require
# Direct connection (same host without "-pooler") for migrations:
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/digifarm?sslmode=require

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
BETTER_AUTH_URL=http://localhost:3000

# --- Google sign-in (optional) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# (Web application). Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3001/api/auth/callback/google
# plus your staging/production domains. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
# "console" prints emails (with verification links) to the dev server log.
# "resend" sends real email (resend.com → API Keys). EMAIL_FROM's domain must be
# verified in Resend; until then use "DigiFarm <onboarding@resend.dev>", which
# only delivers to the Resend account's own email address.
EMAIL_TRANSPORT=console
EMAIL_FROM="DigiFarm <no-reply@digifarm.local>"
RESEND_API_KEY=

# --- File storage ---
# "local" stores files in STORAGE_LOCAL_DIR (gitignored) for development.
# "vercel-blob" stores them in one private Vercel Blob store, under public/ and
# private/. Connecting the store to the Vercel project sets BLOB_STORE_ID; to use
# it from elsewhere, set BLOB_READ_WRITE_TOKEN instead.
# "s3" stores them in one private S3-compatible bucket, under public/ and private/.
# For Cloudflare R2: R2 → Create bucket, then R2 → Manage API tokens → Object
# Read & Write for that bucket. The endpoint is https://<account-id>.r2.cloudflarestorage.com
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Integration tests use a separate database (e.g. a Neon "test" branch).
TEST_DATABASE_URL=
TEST_DIRECT_DATABASE_URL=

# --- Payments (ROADMAP Phase 3) ---
# "fake" is a local stand-in with a test payment page (/dev/pay/…): no money moves.
# "paystack" needs a TEST secret key (sk_test_…); live keys are refused until
# D11, D12 and D14 are resolved. Webhook URL: <APP_URL>/api/webhooks/paystack
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=

# --- Scheduled jobs ---
# /api/cron/* require "Authorization: Bearer <CRON_SECRET>" (Vercel Cron sends it).
# Generate with: openssl rand -base64 24
CRON_SECRET=
