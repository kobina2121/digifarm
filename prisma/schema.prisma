// DigiFarm database schema (docs/ROADMAP.md §3).
// Change it only through migrations: `pnpm db:migrate`.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // Load relations with SQL joins: one round trip per query instead of one
  // per relation. Matters while the database is far away (ROADMAP §10).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (tables shaped for Better Auth) ────────────────────────────────

enum PlatformRole {
  USER // buyers (and later self-service suppliers); access comes from org membership
  OPS // DigiFarm operations staff
  ADMIN
  DELIVERY_PARTNER // reserved, inactive in MVP
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  phone         String?
  platformRole  PlatformRole @default(USER)
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  farmVisits            FarmVisit[]            @relation("FarmVisitor")
  verificationsDecided  SupplierVerification[] @relation("VerificationDecidedBy")
  managedSuppliersAdded Organization[]         @relation("OrganizationCreatedBy")
  auditEntries          AuditLog[]
  listingsCreated       Listing[]              @relation("ListingCreatedBy")
  stockConfirmations    Listing[]              @relation("ListingStockConfirmedBy")
  inventoryMovements    InventoryMovement[]
  gradeEdits            GradeDefinition[]
  ordersPlaced          Order[]                @relation("OrderPlacedBy")
  orderStatusChanges    OrderStatusHistory[]
  refundsRequested      Refund[]               @relation("RefundRequestedBy")
  refundsApproved       Refund[]               @relation("RefundApprovedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Rate-limit counters live in Postgres so limits hold across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Organizations ───────────────────────────────────────────────────────────

enum OrganizationType {
  BUYER
  SUPPLIER
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum BuyerSegment {
  RESTAURANT
  HOTEL
  CATERER
  RETAILER
  WHOLESALER
  FOOD_PROCESSOR
  OTHER
}

// Who a buyer account is for: a person or household, or a business (D18).
enum BuyerKind {
  INDIVIDUAL
  BUSINESS
}

enum SupplierKind {
  FARMER
  COOPERATIVE
  AGGREGATOR
  VENDOR
}

enum MembershipRole {
  OWNER
  MANAGER
  MEMBER
}

model Organization {
  id           String             @id @default(uuid(7)) @db.Uuid
  type         OrganizationType
  status       OrganizationStatus @default(PENDING)
  legalName    String
  tradingName  String?
  phone        String
  email        String?
  region       GhanaRegion
  district     String?
  buyerKind    BuyerKind? // buyers only
  buyerSegment BuyerSegment? // businesses only
  supplierKind SupplierKind?
  // Suppliers are managed by DigiFarm staff (ROADMAP D6) and may have no members.
  createdById  String?
  createdBy    User?              @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  memberships  Membership[]
  addresses    Address[]
  verification SupplierVerification?
  listings     Listing[]
  cart         Cart?
  saved        SavedListing[]
  orders       Order[]
  fulfilments  Fulfilment[]
  ledger       LedgerEntry[]

  @@index([type, status])
  @@map("organization")
}

model Membership {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("membership")
}

// ─── Places ──────────────────────────────────────────────────────────────────

enum GhanaRegion {
  AHAFO
  ASHANTI
  BONO
  BONO_EAST
  CENTRAL
  EASTERN
  GREATER_ACCRA
  NORTH_EAST
  NORTHERN
  OTI
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  VOLTA
  WESTERN
  WESTERN_NORTH
}

// Former delivery areas (Accra, Kumasi). Kept for history: since D4 was
// revised, DigiFarm delivers anywhere in Ghana and addresses use regions.
model OperatingZone {
  id        String      @id @default(uuid(7)) @db.Uuid
  code      String      @unique
  name      String
  region    GhanaRegion
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  addresses Address[]
  listings  Listing[]

  @@map("operating_zone")
}

enum AddressKind {
  DELIVERY // buyer delivery point; must be inside a serviced zone
  PICKUP // farm or collection point; may be anywhere in Ghana
  BUSINESS
}

model Address {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           AddressKind
  label          String
  region         GhanaRegion
  district       String?
  town           String
  street         String?
  landmark       String?
  digitalAddress String? // GhanaPost GPS, e.g. GA-123-4567
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  zoneId         String?        @db.Uuid
  zone           OperatingZone? @relation(fields: [zoneId], references: [id])
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  pickupFor Listing[]

  @@index([organizationId])
  @@map("address")
}

// ─── Supplier verification by farm visit (ROADMAP D7) ────────────────────────

enum VerificationStatus {
  PROSPECT // recruited, not yet visited
  VISITED // at least one visit recorded, awaiting a decision
  APPROVED
  REJECTED
  SUSPENDED
}

model SupplierVerification {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @unique @db.Uuid
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         VerificationStatus @default(PROSPECT)
  decidedById    String?
  decidedBy      User?              @relation("VerificationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  decisionNotes  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  visits FarmVisit[]

  @@index([status])
  @@map("supplier_verification")
}

model FarmVisit {
  id               String               @id @default(uuid(7)) @db.Uuid
  verificationId   String               @db.Uuid
  verification     SupplierVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  visitedById      String
  visitedBy        User                 @relation("FarmVisitor", fields: [visitedById], references: [id])
  visitedAt        DateTime
  latitude         Decimal?             @db.Decimal(9, 6)
  longitude        Decimal?             @db.Decimal(9, 6)
  produceObserved  String
  recommendedGrade String? // A, B or C (grade definitions arrive in Phase 2)
  notes            String?
  createdAt        DateTime             @default(now())

  photos FarmVisitPhoto[]

  @@index([verificationId])
  @@map("farm_visit")
}

// Private files: only reachable through an authorized, short-lived download route.
model FarmVisitPhoto {
  id         String    @id @default(uuid(7)) @db.Uuid
  visitId    String    @db.Uuid
  visit      FarmVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  storageKey String    @unique
  mimeType   String
  sizeBytes  Int
  sha256     String
  createdAt  DateTime  @default(now())

  @@index([visitId])
  @@map("farm_visit_photo")
}

// ─── Audit (append-only; enforced by a database trigger) ─────────────────────

model AuditLog {
  id              String   @id @default(uuid(7)) @db.Uuid
  actorUserId     String?
  // Restrict: users are anonymised, never deleted, so audit history stays intact.
  actor           User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorRole       String?
  onBehalfOfOrgId String?  @db.Uuid
  action          String
  entityType      String
  entityId        String
  before          Json?
  after           Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_log")
}

// ─── Catalogue (ROADMAP Phase 2) ─────────────────────────────────────────────

enum UnitKind {
  MASS // kg, tonne — convertible between each other
  COUNT // piece, tuber
  CONTAINER // bag, crate, basket — never converted to kg automatically
  BUNDLE // bunch
}

model UnitOfMeasure {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique
  name         String
  plural       String
  kind         UnitKind
  // Size in the kind's base unit (kg for MASS); only set where conversion is exact.
  factorToBase Decimal? @db.Decimal(14, 3)
  sortOrder    Int      @default(0)

  listings Listing[]

  @@map("unit_of_measure")
}

model ProductCategory {
  id        String @id @default(uuid(7)) @db.Uuid
  slug      String @unique
  name      String
  sortOrder Int    @default(0)

  products Product[]
  grades   GradeDefinition[]

  @@map("product_category")
}

// DigiFarm's own A/B/C grades per category (ROADMAP D8).
model GradeDefinition {
  id          String          @id @default(uuid(7)) @db.Uuid
  categoryId  String          @db.Uuid
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code        String // A, B or C
  title       String
  description String
  updatedById String?
  updatedBy   User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime        @updatedAt

  listings Listing[]

  @@unique([categoryId, code])
  @@map("grade_definition")
}

// The canonical item, e.g. "Tomato — Pectomech". Suppliers sell it through listings.
model Product {
  id         String          @id @default(uuid(7)) @db.Uuid
  categoryId String          @db.Uuid
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  name       String
  variety    String?
  slug       String          @unique
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  listings Listing[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
  @@index([categoryId])
  @@map("product")
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Listing {
  id                 String           @id @default(uuid(7)) @db.Uuid
  supplierOrgId      String           @db.Uuid
  supplier           Organization     @relation(fields: [supplierOrgId], references: [id])
  productId          String           @db.Uuid
  product            Product          @relation(fields: [productId], references: [id])
  unitId             String           @db.Uuid
  unit               UnitOfMeasure    @relation(fields: [unitId], references: [id])
  gradeId            String?          @db.Uuid
  grade              GradeDefinition? @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  // No longer used: DigiFarm delivers anywhere in Ghana (D4 revised).
  zoneId             String?          @db.Uuid
  zone               OperatingZone?   @relation(fields: [zoneId], references: [id])
  pickupAddressId    String?          @db.Uuid
  pickupAddress      Address?         @relation(fields: [pickupAddressId], references: [id], onDelete: SetNull)
  description        String?
  unitPriceMinor     BigInt
  currency           String           @default("GHS")
  // Minimum orders are off for now (always 1); kept for when they return.
  minOrderQty        Decimal          @default(1) @db.Decimal(14, 3)
  // Informational only (e.g. a 50 kg bag); never used to convert prices.
  netWeightPerUnitKg Decimal?         @db.Decimal(10, 3)
  harvestDate        DateTime?        @db.Date
  availableFrom      DateTime         @db.Date
  availableUntil     DateTime?        @db.Date
  status             ListingStatus    @default(DRAFT)
  statusReason       String?
  // Set when staff confirm stock with the farmer by phone (ROADMAP D1/D6).
  stockConfirmedAt   DateTime?
  stockConfirmedById String?
  stockConfirmedBy   User?            @relation("ListingStockConfirmedBy", fields: [stockConfirmedById], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User             @relation("ListingCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  images     ListingImage[]
  inventory  InventoryRecord?
  cartItems  CartItem[]
  savedBy    SavedListing[]
  orderItems OrderItem[]

  @@index([status, productId])
  @@index([status, zoneId])
  @@index([supplierOrgId])
  @@map("listing")
}

// Public product photos (resized WebP, metadata stripped).
model ListingImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  listingId  String   @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String   @unique // base key; files exist at <key>-480.webp and <key>-1200.webp
  width      Int
  height     Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([listingId, sortOrder])
  @@map("listing_image")
}

model InventoryRecord {
  id        String   @id @default(uuid(7)) @db.Uuid
  listingId String   @unique @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  onHand    Decimal  @default(0) @db.Decimal(14, 3)
  // Held by unpaid checkouts (Phase 3). Available = onHand - reserved.
  reserved  Decimal  @default(0) @db.Decimal(14, 3)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  movements    InventoryMovement[]
  reservations StockReservation[]

  @@map("inventory_record")
}

enum InventoryMovementType {
  ADJUST
  RESERVE
  RELEASE
  COMMIT
  RETURN
}

// Append-only stock history (enforced by a database trigger).
model InventoryMovement {
  id          String                @id @default(uuid(7)) @db.Uuid
  inventoryId String                @db.Uuid
  inventory   InventoryRecord       @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(14, 3) // signed change to on-hand stock
  onHandAfter Decimal               @db.Decimal(14, 3)
  reason      String?
  refType     String?
  refId       String?
  actorUserId String?
  actor       User?                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())

  @@index([inventoryId, createdAt])
  @@map("inventory_movement")
}

// ─── Ordering (ROADMAP Phase 3) ──────────────────────────────────────────────

// One server-side cart per buyer business, shared by its members.
model Cart {
  id         String       @id @default(uuid(7)) @db.Uuid
  buyerOrgId String       @unique @db.Uuid
  buyer      Organization @relation(fields: [buyerOrgId], references: [id], onDelete: Cascade)
  updatedAt  DateTime     @updatedAt

  items CartItem[]

  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @db.Uuid
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId String   @db.Uuid
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Decimal  @db.Decimal(14, 3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, listingId])
  @@map("cart_item")
}

/// A buyer's saved (favourite) listings: one heart per listing, newest first.
model SavedListing {
  id         String       @id @default(uuid(7)) @db.Uuid
  buyerOrgId String       @db.Uuid
  buyer      Organization @relation(fields: [buyerOrgId], references: [id], onDelete: Cascade)
  listingId  String       @db.Uuid
  listing    Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([buyerOrgId, listingId])
  @@index([buyerOrgId, createdAt])
  @@map("saved_listing")
}

enum OrderChannel {
  MARKETPLACE
  MANAGED // from an accepted sourcing quotation
}

enum OrderStatus {
  PENDING_PAYMENT // stock held while the buyer pays
  PAID // paid = confirmed (ROADMAP D1)
  IN_FULFILMENT
  PARTIALLY_DELIVERED
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED // payment didn't arrive before the hold ended
}

model Order {
  id                      String       @id @default(uuid(7)) @db.Uuid
  number                  String       @unique // e.g. DF-2026-000123
  buyerOrgId              String       @db.Uuid
  buyer                   Organization @relation(fields: [buyerOrgId], references: [id])
  placedById              String
  placedBy                User         @relation("OrderPlacedBy", fields: [placedById], references: [id])
  channel                 OrderChannel @default(MARKETPLACE)
  status                  OrderStatus  @default(PENDING_PAYMENT)
  currency                String       @default("GHS")
  subtotalMinor           BigInt
  deliveryFeeMinor        BigInt
  totalMinor              BigInt
  zoneId                  String?      @db.Uuid // unused since D4 was revised
  deliveryAddressSnapshot Json
  buyerNotes              String?
  holdExpiresAt           DateTime
  idempotencyKey          String       @unique
  paidAt                  DateTime?
  cancelledAt             DateTime?
  cancelReason            String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  fulfilments Fulfilment[]
  items       OrderItem[]
  history     OrderStatusHistory[]
  payments    Payment[]
  ledger      LedgerEntry[]

  @@index([buyerOrgId, createdAt])
  @@index([status, holdExpiresAt])
  @@map("order")
}

enum FulfilmentStatus {
  PENDING // waiting for payment
  CONFIRMED // paid; DigiFarm's stock is the truth, so no farm confirmation step
  PICKED_UP
  DELIVERED
  CANCELLED
}

// One per (order, supplier): how a multi-farm order is split.
model Fulfilment {
  id            String           @id @default(uuid(7)) @db.Uuid
  orderId       String           @db.Uuid
  order         Order            @relation(fields: [orderId], references: [id])
  supplierOrgId String           @db.Uuid
  supplier      Organization     @relation(fields: [supplierOrgId], references: [id])
  supplierName  String // snapshot
  status        FulfilmentStatus @default(PENDING)
  subtotalMinor BigInt
  commissionBps Int // snapshot of DigiFarm's commission (D2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items  OrderItem[]
  ledger LedgerEntry[]

  @@unique([orderId, supplierOrgId])
  @@index([supplierOrgId, status])
  @@map("fulfilment")
}

model OrderItem {
  id             String     @id @default(uuid(7)) @db.Uuid
  orderId        String     @db.Uuid
  order          Order      @relation(fields: [orderId], references: [id])
  fulfilmentId   String     @db.Uuid
  fulfilment     Fulfilment @relation(fields: [fulfilmentId], references: [id])
  listingId      String?    @db.Uuid
  listing        Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Snapshots: later listing edits never change a past order.
  productName    String
  variety        String?
  gradeCode      String?
  unitCode       String
  unitName       String
  unitPlural     String
  quantity       Decimal    @db.Decimal(14, 3)
  unitPriceMinor BigInt
  lineTotalMinor BigInt
  createdAt      DateTime   @default(now())

  reservation StockReservation?

  @@index([orderId])
  @@map("order_item")
}

model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @db.Uuid
  order       Order        @relation(fields: [orderId], references: [id])
  from        OrderStatus?
  to          OrderStatus
  reason      String?
  actorUserId String?
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum ReservationStatus {
  ACTIVE // holding stock while the buyer pays
  COMMITTED // paid: taken out of stock
  RELEASED // hold ended or order cancelled before payment
}

model StockReservation {
  id          String            @id @default(uuid(7)) @db.Uuid
  inventoryId String            @db.Uuid
  inventory   InventoryRecord   @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  orderItemId String            @unique @db.Uuid
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id])
  quantity    Decimal           @db.Decimal(14, 3)
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, expiresAt])
  @@index([inventoryId, status])
  @@map("stock_reservation")
}

// ─── Payments (ROADMAP Phase 3; Paystack test mode until D11/D12/D14) ─────────

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  orderId     String        @db.Uuid
  order       Order         @relation(fields: [orderId], references: [id])
  provider    String // "paystack" or "fake" (development only)
  amountMinor BigInt
  currency    String        @default("GHS")
  status      PaymentStatus @default(PENDING)
  feeMinor    BigInt? // provider's fee, from verification
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  attempts PaymentAttempt[]
  refunds  Refund[]
  ledger   LedgerEntry[]

  @@unique([orderId])
  @@map("payment")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCEEDED
  FAILED
  ABANDONED
}

// One trip to the provider's checkout. A buyer can retry while the hold lasts.
model PaymentAttempt {
  id                    String               @id @default(uuid(7)) @db.Uuid
  paymentId             String               @db.Uuid
  payment               Payment              @relation(fields: [paymentId], references: [id])
  provider              String
  reference             String // our reference, sent to the provider
  authorizationUrl      String?
  providerTransactionId String?
  channel               String? // mobile_money, card, …
  status                PaymentAttemptStatus @default(INITIATED)
  rawStatus             String?
  failureReason         String?
  verifiedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  refunds Refund[]

  @@unique([provider, reference])
  @@index([paymentId])
  @@map("payment_attempt")
}

// Webhook dedupe log: the same event is processed once, however often it arrives.
model ProviderEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("provider_event")
}

enum RefundStatus {
  PENDING // recorded, not yet sent to the provider
  PROCESSING // accepted by the provider
  SUCCEEDED
  FAILED
}

model Refund {
  id                String         @id @default(uuid(7)) @db.Uuid
  paymentId         String         @db.Uuid
  payment           Payment        @relation(fields: [paymentId], references: [id])
  // The charge being refunded (a payment can have more than one if a buyer paid twice).
  attemptId         String         @db.Uuid
  attempt           PaymentAttempt @relation(fields: [attemptId], references: [id])
  amountMinor       BigInt
  reason            String
  status            RefundStatus   @default(PENDING)
  providerReference String?
  failureReason     String?
  requestedById     String?
  requestedBy       User?          @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById      String?
  approvedBy        User?          @relation("RefundApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  ledger LedgerEntry[]

  @@index([paymentId])
  @@index([status])
  @@map("refund")
}

enum LedgerEntryType {
  PAYMENT_CAPTURED // + money received from the buyer
  PROVIDER_FEE // - the payment provider's fee
  SUPPLIER_PAYABLE // + owed to a farm (its share after commission); negative to reverse
  COMMISSION // + DigiFarm's commission (D2); negative to reverse
  DELIVERY_FEE // + delivery charged to the buyer
  REFUND // - money returned to the buyer
}

// Append-only financial journal (enforced by a database trigger). Corrections
// are new reversing entries, never edits.
model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  type          LedgerEntryType
  amountMinor   BigInt // signed
  currency      String          @default("GHS")
  orderId       String?         @db.Uuid
  order         Order?          @relation(fields: [orderId], references: [id])
  fulfilmentId  String?         @db.Uuid
  fulfilment    Fulfilment?     @relation(fields: [fulfilmentId], references: [id])
  supplierOrgId String?         @db.Uuid
  supplier      Organization?   @relation(fields: [supplierOrgId], references: [id])
  paymentId     String?         @db.Uuid
  payment       Payment?        @relation(fields: [paymentId], references: [id])
  refundId      String?         @db.Uuid
  refund        Refund?         @relation(fields: [refundId], references: [id])
  memo          String?
  createdAt     DateTime        @default(now())

  @@index([orderId])
  @@index([supplierOrgId, type])
  @@index([type, createdAt])
  @@map("ledger_entry")
}
